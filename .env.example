# Copiar a .env (raíz del proyecto) y completar. Nunca commitear el .env real.

# --- Obligatorias en producción ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DEBUG=False
ALLOWED_HOSTS=api.tudominio.com
DATABASE_URL=postgresql://usuario:password@host:5432/base
# Con el BFF el navegador no llama a la API: en producción dejarlo vacío (CORS cerrado).
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=https://app.tudominio.com

# Secreto compartido con el BFF (servidor de Next.js). Con él la API confía en la IP real del
# usuario que reenvía el BFF para los límites de intentos. Generar uno largo y aleatorio.
BFF_SHARED_SECRET=

# --- Correo (Resend) — configuración propia de Projects ---
# Sin RESEND_API_KEY los correos se escriben en la consola (desarrollo).
RESEND_API_KEY=
EMAIL_FROM=Velatrix One · Projects <no-reply@tu-dominio-verificado.com>
# EMAIL_REPLY_TO=soporte@tu-dominio.com

# --- Opcionales ---
# DATABASE_SSL=True
# TIME_ZONE=America/Argentina/Buenos_Aires
# JWT_ACCESS_MINUTES=10
# JWT_REFRESH_DAYS=7
# SESSION_ABSOLUTE_DAYS=30
# THROTTLE_PASSWORD_RESET=10/hour
# THROTTLE_PASSWORD_RESET_EMAIL=3/hour
# THROTTLE_AUTH=10/min
# THROTTLE_INVITATION=30/min
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=0

# --- Cloudinary (si no se configura, las imágenes se guardan en disco local /media) ---
# CLOUD_NAME=
# CLOUD_API_KEY=
# CLOUD_API_SECRET=
