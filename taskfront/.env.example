# Copiar a .env.local para desarrollo. Todas son SOLO del servidor (sin NEXT_PUBLIC_):
# el navegador nunca habla con la API ni ve tokens.

# URL de la API de Django (incluye /api/v1)
API_URL=http://127.0.0.1:8000/api/v1

# Clave para cifrar la cookie de sesión. Mínimo 32 caracteres aleatorios.
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Debe coincidir con BFF_SHARED_SECRET del backend (para que la API confíe en la IP real del usuario).
BFF_SHARED_SECRET=
